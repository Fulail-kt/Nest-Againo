DATABASE_URL="postgresql://postgres:admin@localhost:5433/nestpro?schema=public"
JWT_SECRET="change-me-to-32-plus-random-chars"

# WhatsApp Cloud API — server only. Never put META_APP_SECRET in the app.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=
WA_TOKEN_KEY=
WA_TEST_TEMPLATE=
WA_GREETING_TEMPLATE=client_welcome
WA_TEMPLATE_LANG=en
PUBLIC_API_URL=

# Railway test only — pings PUBLIC_API_URL/health every 10 min. Remove later.
KEEP_ALIVE=

# Client cut photos — Cloudinary (not local disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Free SMTP via nodemailer (library is free). Need a mailbox to send:
# Brevo (300/day, no card): smtp-relay.brevo.com
# Gmail app password: smtp.gmail.com  (Google Account → Security → App passwords)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Againo <YOUR_GMAIL_OR_VERIFIED_SENDER@email.com>"

# Optional second mailbox if Brevo hits 300/day or SMTP errors. Same nodemailer, different server (Gmail app password).
# SMTP_FALLBACK_HOST=smtp.gmail.com
# SMTP_FALLBACK_PORT=587
# SMTP_FALLBACK_USER=
# SMTP_FALLBACK_PASS=
# SMTP_FALLBACK_MAIL_FROM=

# Google sign-in — Web client ID required. Android/iOS IDs if you add those OAuth clients.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
